@page "/Register-Login"
@model RegisterLoginModel
@{
    Layout = null;
    ViewData["Title"] = "Вход для гостей";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Вход для гостей — Qonaq Hotels</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400&family=Montserrat:wght@600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="login-page">
    <div class="login-card" style="max-width:440px">
        <div class="logo-block">
            <div style="font-family:var(--font-heading);font-size:1.4rem;font-weight:600;color:var(--c-dark)">QONAQ</div>
            <div style="font-size:.65rem;letter-spacing:.15em;color:#888">HOTELS</div>
        </div>
        <h1>Личный кабинет гостя</h1>

        <div class="tab-switch" role="tablist">
            <button type="button" class="tab-btn @(Model.ActiveTab == "login" ? "active" : "")"
                    data-tab-target="tab-login" role="tab">Вход</button>
            <button type="button" class="tab-btn @(Model.ActiveTab == "register" ? "active" : "")"
                    data-tab-target="tab-register" role="tab">Регистрация</button>
        </div>

        @if (Model.ErrorMessage != null) {
            <div class="alert-error">@Model.ErrorMessage</div>
        }
        @if (Model.SuccessMessage != null) {
            <div class="alert-ok">@Model.SuccessMessage</div>
        }

        <div id="tab-login" class="tab-pane @(Model.ActiveTab == "login" ? "active" : "")">
            <form method="post" asp-page-handler="Login">
                <div class="form-group">
                    <label asp-for="Login.LoginName">Логин</label>
                    <input asp-for="Login.LoginName" type="text" autocomplete="username" />
                    <span asp-validation-for="Login.LoginName" class="text-danger" style="font-size:.8rem"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Login.Password">Пароль</label>
                    <div class="password-wrapper">
                        <input asp-for="Login.Password" type="password"
                               autocomplete="current-password"
                               data-capslock-warning="caps-warning-l" />
                        <button type="button" class="btn-eye" data-toggle-password aria-label="Показать пароль">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <small class="caps-warning" id="caps-warning-l">Включён Caps Lock</small>
                    <span asp-validation-for="Login.Password" class="text-danger" style="font-size:.8rem"></span>
                </div>
                <div class="form-group" style="display:flex;align-items:center;gap:.5rem">
                    <input asp-for="Login.RememberMe" type="checkbox" id="guest-remember" />
                    <label for="guest-remember" style="margin:0;font-size:.85rem">Запомнить меня</label>
                </div>
                <button type="submit" class="btn-primary" style="width:100%;margin-top:.5rem">Войти</button>
            </form>
        </div>

        <div id="tab-register" class="tab-pane @(Model.ActiveTab == "register" ? "active" : "")">
            <form method="post" asp-page-handler="Register">
                <div class="form-group">
                    <label asp-for="Register.FullName">ФИО</label>
                    <input asp-for="Register.FullName" type="text" autocomplete="name" />
                    <span asp-validation-for="Register.FullName" class="text-danger" style="font-size:.8rem"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Register.LoginName">Логин</label>
                    <input asp-for="Register.LoginName" type="text" autocomplete="username" />
                    <span asp-validation-for="Register.LoginName" class="text-danger" style="font-size:.8rem"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Register.Password">Пароль</label>
                    <div class="password-wrapper">
                        <input asp-for="Register.Password" type="password"
                               autocomplete="new-password"
                               data-capslock-warning="caps-warning-r" />
                        <button type="button" class="btn-eye" data-toggle-password aria-label="Показать пароль">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <small class="caps-warning" id="caps-warning-r">Включён Caps Lock</small>
                    <span asp-validation-for="Register.Password" class="text-danger" style="font-size:.8rem"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Register.DocumentNumber">Номер документа</label>
                    <input asp-for="Register.DocumentNumber" type="text" />
                    <span asp-validation-for="Register.DocumentNumber" class="text-danger" style="font-size:.8rem"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Register.Phone">Телефон (необязательно)</label>
                    <input asp-for="Register.Phone" type="tel" autocomplete="tel" />
                </div>
                <div class="form-group">
                    <label asp-for="Register.Email">E-mail (необязательно)</label>
                    <input asp-for="Register.Email" type="email" autocomplete="email" />
                    <span asp-validation-for="Register.Email" class="text-danger" style="font-size:.8rem"></span>
                </div>
                <button type="submit" class="btn-primary" style="width:100%;margin-top:.5rem">Зарегистрироваться</button>
            </form>
        </div>

        <div class="login-footer">
            <a href="/Login" class="switch-link">Я сотрудник →</a>
            <a href="/" class="back-link">← На главную</a>
        </div>
    </div>
</div>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
    document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const target = btn.dataset.tabTarget;
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.toggle('active', b === btn));
            document.querySelectorAll('.tab-pane').forEach(p => p.classList.toggle('active', p.id === target));
        });
    });
</script>
</body>
</html>
