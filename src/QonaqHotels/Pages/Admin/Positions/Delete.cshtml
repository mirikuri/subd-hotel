@page "{id:int}"
@model DeleteModel
@{ ViewData["Title"] = "Удалить должность"; }

<h4>Удалить должность</h4>

<div asp-validation-summary="All" class="text-danger mb-3"></div>

@if (Model.EmployeeCount > 0)
{
    <div class="alert alert-danger">
        Нельзя удалить должность «@Model.PositionName» — к ней привязано сотрудников: <strong>@Model.EmployeeCount</strong>.
        Сначала переназначьте или удалите этих сотрудников.
    </div>
    <a asp-page="Index" class="btn btn-secondary">Назад</a>
}
else
{
    <div class="alert alert-warning">Это действие необратимо.</div>
    <dl class="row">
        <dt class="col-sm-3">Название</dt>
        <dd class="col-sm-9">@Model.PositionName</dd>
        <dt class="col-sm-3">Роль в системе</dt>
        <dd class="col-sm-9">@Model.Role</dd>
    </dl>
    <form method="post">
        <button type="submit" class="btn btn-danger">Удалить</button>
        <a asp-page="Index" class="btn btn-secondary ms-2">Отмена</a>
    </form>
}
