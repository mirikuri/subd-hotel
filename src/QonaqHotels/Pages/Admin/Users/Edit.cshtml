@page "{id:int}"
@model EditModel
@{ ViewData["Title"] = "Изменить пользователя"; }

<h4>Изменить пользователя</h4>
<div class="row"><div class="col-md-6">
<form method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label class="form-label">Сотрудник</label>
        <input type="text" class="form-control" value="@Model.EmployeeName" disabled />
    </div>
    <div class="mb-3">
        <label asp-for="Login" class="form-label">Логин</label>
        <input asp-for="Login" class="form-control" required />
    </div>
    <div class="mb-3">
        <label asp-for="Role" class="form-label">Роль</label>
        <select asp-for="Role" class="form-select">
            <option value="админ">админ</option>
            <option value="ресепшен">ресепшен</option>
            <option value="бухгалтер">бухгалтер</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="NewPassword" class="form-label">Новый пароль <small class="text-muted">(оставьте пустым, чтобы не менять)</small></label>
        <input asp-for="NewPassword" type="password" class="form-control" />
        <span asp-validation-for="NewPassword" class="text-danger small"></span>
    </div>
    <div class="mb-3 form-check">
        <input asp-for="IsActive" type="checkbox" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label">Активен</label>
    </div>
    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a asp-page="Index" class="btn btn-secondary ms-2">Отмена</a>
</form>
</div></div>

<script>
(function() {
    var v = window.adminValidation;
    var form = document.querySelector('form');
    var passwordInput = form.querySelector('#NewPassword');
    var validators = [
        function() { return v.validatePassword(passwordInput); }
    ];
    v.bindSubmitGate(form, validators);
})();
</script>
