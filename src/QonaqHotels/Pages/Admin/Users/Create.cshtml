@page
@model CreateModel
@{ ViewData["Title"] = "Добавить пользователя"; }

<h4>Добавить пользователя</h4>
<div class="row"><div class="col-md-6">
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="EmployeeId" class="form-label">Сотрудник</label>
        <select asp-for="EmployeeId" asp-items="Model.Employees" class="form-select">
            <option value="">— выберите —</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Login" class="form-label">Логин</label>
        <input asp-for="Login" class="form-control" required />
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label">Пароль</label>
        <input asp-for="Password" type="password" class="form-control" required />
    </div>
    <div class="mb-3">
        <label asp-for="Role" class="form-label">Роль</label>
        <select asp-for="Role" class="form-select">
            <option value="админ">админ</option>
            <option value="ресепшен" selected>ресепшен</option>
            <option value="бухгалтер">бухгалтер</option>
            <option value="управляющий арендой">управляющий арендой</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a asp-page="Index" class="btn btn-secondary ms-2">Отмена</a>
</form>
</div></div>
