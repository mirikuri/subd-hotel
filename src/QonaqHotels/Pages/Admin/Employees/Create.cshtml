@page
@model CreateModel
@{ ViewData["Title"] = "Добавить сотрудника"; }

<h4>Добавить сотрудника</h4>
<div class="row"><div class="col-md-6">
<form method="post">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="FullName" class="form-label">ФИО</label>
        <input asp-for="FullName" class="form-control" required />
        <span asp-validation-for="FullName" class="text-danger small"></span>
        <div class="form-text">Минимум 2 символа</div>
    </div>
    <div class="mb-3">
        <label asp-for="Phone" class="form-label">Телефон</label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger small"></span>
        <div class="form-text">Формат: +XXXXXXXXXXX (11–12 цифр после +)</div>
    </div>
    <div class="mb-3">
        <label asp-for="HotelId" class="form-label">Отель</label>
        <select asp-for="HotelId" asp-items="Model.Hotels" class="form-select">
            <option value="">— выберите —</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="PositionId" class="form-label">Должность</label>
        <select asp-for="PositionId" asp-items="Model.Positions" class="form-select">
            <option value="">— выберите —</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="HireDate" class="form-label">Дата приёма</label>
        <input asp-for="HireDate" type="date" class="form-control" />
        <span asp-validation-for="HireDate" class="text-danger small"></span>
        <div class="form-text">Не более чем на 30 дней вперёд</div>
    </div>
    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a asp-page="Index" class="btn btn-secondary ms-2">Отмена</a>
</form>
</div></div>

<script>
(function() {
    var v = window.adminValidation;
    var form = document.querySelector('form');
    var nameInput = form.querySelector('#FullName');
    var phoneInput = form.querySelector('#Phone');
    var hireInput = form.querySelector('#HireDate');

    hireInput.max = new Date(Date.now() + 30*24*60*60*1000).toISOString().split('T')[0];

    var validators = [
        function() { return v.validateName(nameInput); },
        function() { return v.validatePhone(phoneInput); },
        function() { return v.validateHireDate(hireInput); }
    ];
    v.bindSubmitGate(form, validators);
})();
</script>
