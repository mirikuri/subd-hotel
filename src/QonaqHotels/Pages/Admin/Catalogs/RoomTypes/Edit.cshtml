@page "{id:int?}"
@model QonaqHotels.Pages.Admin.Catalogs.RoomTypes.EditModel
@using QonaqHotels.Models
@{ ViewData["Title"] = Model.Id is null ? "Добавить тип номера" : "Изменить тип номера"; }

<h4>@ViewData["Title"]</h4>
<div class="row"><div class="col-md-6">
<form method="post">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <div class="mb-3"><label class="form-label">Название</label><input asp-for="Name" class="form-control" required /></div>
    <div class="row">
        <div class="col mb-3"><label class="form-label">Мест</label><input asp-for="Capacity" type="number" min="1" class="form-control" /></div>
        <div class="col mb-3"><label class="form-label">Площадь, м²</label><input asp-for="AreaM2" type="number" step="0.1" min="0.1" class="form-control" /></div>
        <div class="col mb-3"><label class="form-label">Кровать</label>
            <select asp-for="BedType" class="form-select">
                <option value="">—</option>
                @foreach (var b in BedType.All) { <option value="@b">@b</option> }
            </select>
        </div>
    </div>
    <div class="mb-3"><label class="form-label">Описание</label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>
    <div class="mb-3"><label class="form-label">Удобства</label><br />
        @foreach (var a in Model.AllAmenities) {
            <label class="me-3"><input type="checkbox" name="AmenityIds" value="@a.Id" checked="@Model.AmenityIds.Contains(a.Id)" />
                <i class="bi bi-@(a.Icon ?? "check2")"></i> @a.Name</label>
        }
    </div>
    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a asp-page="Index" class="btn btn-secondary ms-2">Отмена</a>
</form>
</div></div>
