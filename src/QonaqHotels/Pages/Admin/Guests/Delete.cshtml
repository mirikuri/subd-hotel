@page "{id:int}"
@model DeleteModel
@{ ViewData["Title"] = "Удалить гостя"; }

<h4>Удалить гостя</h4>

<div asp-validation-summary="All" class="text-danger mb-3"></div>

@if (Model.BookingCount > 0)
{
    <div class="alert alert-danger">
        Нельзя удалить гостя «@Model.GuestName» — у него <strong>@Model.BookingCount</strong> брон(ей).
        Сначала удалите или отмените все брони этого гостя.
    </div>
    <a asp-page="Index" class="btn btn-secondary">Назад</a>
}
else
{
    <div class="alert alert-warning">Это действие необратимо.</div>
    <dl class="row">
        <dt class="col-sm-3">ФИО</dt>
        <dd class="col-sm-9">@Model.GuestName</dd>
        <dt class="col-sm-3">Документ</dt>
        <dd class="col-sm-9">@Model.DocumentNumber</dd>
    </dl>
    <form method="post">
        <button type="submit" class="btn btn-danger">Удалить</button>
        <a asp-page="Index" class="btn btn-secondary ms-2">Отмена</a>
    </form>
}
