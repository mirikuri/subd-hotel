@page "{id:int}"
@model EditModel
@{ ViewData["Title"] = "Изменить данные гостя"; }

<h4>Изменить данные гостя</h4>
<div class="row"><div class="col-md-6">
<form method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="FullName" class="form-label">ФИО</label>
        <input asp-for="FullName" class="form-control" required />
    </div>
    <div class="mb-3">
        <label asp-for="DocumentNumber" class="form-label">Номер документа</label>
        <input asp-for="DocumentNumber" class="form-control" required />
    </div>
    <div class="mb-3">
        <label asp-for="BirthDate" class="form-label">Дата рождения</label>
        <input asp-for="BirthDate" type="date" class="form-control"
               value="@(Model.BirthDate?.ToString("yyyy-MM-dd") ?? "")" />
    </div>
    <div class="mb-3">
        <label asp-for="Phone" class="form-label">Телефон</label>
        <input asp-for="Phone" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" type="email" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="CountryId" class="form-label">Страна</label>
        <select asp-for="CountryId" asp-items="Model.Countries" class="form-select">
            <option value="">— не указана —</option>
        </select>
    </div>
    <div class="mb-3">
        <div class="form-check">
            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
            <label asp-for="IsActive" class="form-check-label fw-semibold">Активен</label>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a asp-page="Index" class="btn btn-secondary ms-2">Отмена</a>
</form>
</div></div>

<script>
(function() {
    var v = window.adminValidation;
    var form = document.querySelector('form');
    var nameInput = form.querySelector('#FullName');
    var phoneInput = form.querySelector('#Phone');
    var birthInput = form.querySelector('#BirthDate');

    if (birthInput) birthInput.max = new Date().toISOString().split('T')[0];

    var validators = [
        function() { return v.validateName(nameInput); },
        function() { return v.validatePhone(phoneInput); }
    ];
    v.bindSubmitGate(form, validators);
})();
</script>
